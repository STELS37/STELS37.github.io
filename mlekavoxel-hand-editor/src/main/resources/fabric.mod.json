{
  "schemaVersion": 1,
  "id": "mlekavoxel_hand_editor",
  "version": "${version}",
  "name": "MlekaVoxel Hand Editor",
  "description": "Independent 3-axis first-person hand positioning, non-zero real scaling and Mleka Flow swing animation for Minecraft 26.1.2.",
  "authors": ["MlekaVoxel"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.globalsystem.mlekavoxel.handeditor.MlekaHandEditorClient"
    ]
  },
  "mixins": [
    {
      "config": "mlekavoxel_hand_editor.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2+26.1.2"
  }
}
